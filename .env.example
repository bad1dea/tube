# Public DNS name; Caddy gets a certificate for it. Use "localhost" for a test.
CONCH_DOMAIN=localhost

# Required on anything reachable from the internet: clients send it when
# creating a vault. Pairing and recovery do not need it.
CONCH_REGISTRATION_TOKEN=

# Web client SSH relay. Create a token with:
#   docker compose run --rm gateway conch-gateway token <name>
# and put the printed "<name>:<hash>" here (comma separate several).
CONCH_GATEWAY_TOKENS=
# Destinations the relay may connect to: CIDR or host name with :port or :*
# e.g. 10.0.0.0/8:22,192.168.1.0/24:*,bastion.example.com:2222
CONCH_GATEWAY_ALLOW=
