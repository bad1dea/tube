default_platform(:ios)

# Builds Tube on a cloud macOS runner and ships it to TestFlight.
# MANUAL signing: the workflow installs a fixed distribution cert + App Store
# provisioning profile (from repo secrets) into a temp keychain, and we sign
# with them explicitly. No automatic signing → no throwaway Apple Development
# certs get created/revoked (which was emailing you every build). The ASC API
# key is still used, but only to upload to TestFlight.
#
# `beta` (the main lane) now AUTO-DISTRIBUTES: after upload it waits for Apple
# to finish processing, then adds the build to the internal tester group so
# TestFlight emails testers ("ready to test"). No second manual step. The
# `distribute` and `status` lanes remain as standalone tools.

APP_BUNDLE_ID = "pro.imnot.tube".freeze

# Authenticate Spaceship's ConnectAPI with the ASC key (base64 in ENV).
def asc_login
  require "spaceship"
  require "base64"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key: Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64"))
  )
end

# A new app has no TestFlight groups. Create "Internal" and give it the same
# testers as PrivateGallery's internal group (internal testers must already
# be App Store Connect users, which those are).
TESTER_SOURCE_BUNDLE_ID = "pro.imnot.privategallery".freeze

def ensure_internal_group(app)
  group = (app.get_beta_groups rescue []).find { |g| g.is_internal_group }
  unless group
    # Spaceship's create_beta_group always sends publicLink* fields, which
    # Apple rejects for internal groups, so post the minimal body directly.
    body = {
      data: {
        type: "betaGroups",
        attributes: { name: "Internal", isInternalGroup: true, hasAccessToAllBuilds: true },
        relationships: { app: { data: { type: "apps", id: app.id } } }
      }
    }
    group = Spaceship::ConnectAPI.client.test_flight_request_client.post("v1/betaGroups", body).to_models.first
    UI.success("created internal beta group '#{group.name}'")
  end

  have = Spaceship::ConnectAPI.get_beta_testers(filter: { betaGroups: group.id }).all_pages.flat_map(&:to_models).map(&:id)
  if have.empty?
    source = Spaceship::ConnectAPI::App.find(TESTER_SOURCE_BUNDLE_ID)
    source_group = source && (source.get_beta_groups rescue []).find { |g| g.is_internal_group }
    if source_group
      testers = Spaceship::ConnectAPI.get_beta_testers(filter: { betaGroups: source_group.id }).all_pages.flat_map(&:to_models)
      testers.each do |t|
        # Tester ids are per app; assign by email so Tube gets its own record.
        Spaceship::ConnectAPI.post_beta_tester_assignment(
          beta_group_ids: [group.id],
          attributes: { email: t.email, firstName: t.first_name, lastName: t.last_name }.compact
        )
        UI.success("added tester #{t.email} to '#{group.name}'")
      rescue StandardError => e
        UI.important("could not add #{t.email} to '#{group.name}': #{e.message}. Add them in TestFlight > Internal Testing.")
      end
    end
  end
  UI.message("internal group '#{group.name}' has #{[have.count, 0].max} tester(s) before this run")
  group
end

# Add a processed build to the internal beta group — the step that flips a build
# from READY_FOR_BETA_TESTING → IN_BETA_TESTING and notifies internal testers.
# `build_number` nil/"" = latest VALID build. Retries because the ConnectAPI list
# can lag a few seconds behind a build becoming VALID.
def add_build_to_internal_group(build_number: nil, attempts: 8, wait: 20)
  want = build_number.to_s.strip
  app = Spaceship::ConnectAPI::App.find(APP_BUNDLE_ID)
  group = ensure_internal_group(app)

  build = nil
  attempts.times do |i|
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, sort: "-version", limit: 8, includes: "buildBetaDetail"
    )
    candidate = want.empty? ? builds.find { |b| b.processing_state == "VALID" }
                            : builds.find { |b| b.version == want }
    if candidate && candidate.processing_state == "VALID"
      build = candidate
      break
    end
    UI.message("build #{want.empty? ? '(latest)' : want} not VALID yet " \
               "(#{candidate&.processing_state || 'not listed'}); retry #{i + 1}/#{attempts}…")
    sleep(wait) unless i == attempts - 1
  end
  UI.user_error!("Build #{want.empty? ? '(latest)' : want} never became VALID in time") unless build

  UI.message("Adding build #{build.version} to internal group '#{group.name}'…")
  build.add_beta_groups(beta_groups: [group])
  UI.success("Build #{build.version} distributed to '#{group.name}' — testers notified.")
end

platform :ios do
  # One-time Apple setup with the ASC API key: register the bundle id and make
  # the App Store profile against the distribution cert in DIST_CERT_SERIAL.
  # Writes the profile to ../build/profile.mobileprovision. The App Store
  # Connect app record cannot be created through the API; it only reports it.
  desc "Register bundle id and create the App Store provisioning profile"
  lane :setup do
    asc_login
    bid = Spaceship::ConnectAPI::BundleId.find(APP_BUNDLE_ID)
    if bid
      UI.message("bundle id #{APP_BUNDLE_ID} already registered (#{bid.id})")
    else
      bid = Spaceship::ConnectAPI::BundleId.create(name: "Tube", identifier: APP_BUNDLE_ID, platform: "IOS")
      UI.success("registered bundle id #{APP_BUNDLE_ID} (#{bid.id})")
    end

    serial = ENV.fetch("DIST_CERT_SERIAL").downcase.sub(/^0+/, "")
    certs = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION,IOS_DISTRIBUTION" })
    cert = certs.find { |c| c.serial_number.to_s.downcase.sub(/^0+/, "") == serial }
    UI.user_error!("No distribution certificate with serial #{serial} (have: #{certs.map(&:serial_number).join(', ')})") unless cert
    UI.message("using certificate #{cert.name} (#{cert.id}), expires #{cert.expiration_date}")

    name = ENV.fetch("PROFILE_NAME", "Tube AppStore")
    existing = Spaceship::ConnectAPI::Profile.all(filter: { name: name })
    existing.each do |p|
      UI.message("deleting existing profile '#{p.name}' (#{p.profile_state})")
      p.delete!
    end
    profile = Spaceship::ConnectAPI::Profile.create(
      name: name, profile_type: "IOS_APP_STORE",
      bundle_id_id: bid.id, certificate_ids: [cert.id], device_ids: []
    )
    out = File.expand_path("../build/profile.mobileprovision", __dir__)
    FileUtils.mkdir_p(File.dirname(out))
    File.binwrite(out, Base64.decode64(profile.profile_content))
    UI.success("created profile '#{name}' (#{profile.uuid}), expires #{profile.expiration_date}")

    app = Spaceship::ConnectAPI::App.find(APP_BUNDLE_ID)
    if app
      UI.success("App Store Connect app record exists: #{app.name} (#{app.id})")
      ensure_internal_group(app)
    else
      UI.important("No App Store Connect app record for #{APP_BUNDLE_ID} yet; create it in the web UI.")
    end
  end

  # Read-only diagnostic: list recent builds + their exact TestFlight state
  # (processingState + internal/external beta state). This is what reveals WHY a
  # build that "finished processing" isn't testable — e.g. it's still only
  # READY_FOR_BETA_TESTING (uploaded+valid but not yet added to the internal
  # group), or MISSING_EXPORT_COMPLIANCE / PROCESSING / INVALID / EXPIRED.
  # TestFlight crash reports testers submitted, with the symbolicated log text.
  desc "Print TestFlight crash submissions"
  lane :crashes do
    asc_login
    app = Spaceship::ConnectAPI::App.find(APP_BUNDLE_ID)
    c = Spaceship::ConnectAPI.client.test_flight_request_client
    subs = c.get("v1/apps/#{app.id}/betaFeedbackCrashSubmissions", { limit: 10 }).body["data"] || []
    UI.important("no crash submissions") if subs.empty?
    subs.each do |sub|
      a = sub["attributes"] || {}
      UI.message("==== crash #{sub['id']} #{a['createdDate']} build=#{a['buildBundleId'] || ''} device=#{a['deviceModel']} os=#{a['osVersion']} comment=#{a['comment'].inspect}")
      log = c.get("v1/betaFeedbackCrashSubmissions/#{sub['id']}/crashLog").body.dig("data", "attributes", "logText") rescue nil
      puts(log || "(no log text)")
    end
  end

  desc "Print recent TestFlight builds + their processing/beta state"
  lane :status do
    asc_login
    app = Spaceship::ConnectAPI::App.find(APP_BUNDLE_ID)
    UI.message("App: #{app.name} (id #{app.id})")

    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, sort: "-version", limit: 12,
      includes: "preReleaseVersion,buildBetaDetail,betaAppReviewSubmission"
    )
    UI.important("No builds returned for this app at all.") if builds.empty?

    builds.each do |b|
      detail = (b.build_beta_detail rescue nil)
      ver    = (b.pre_release_version&.version rescue "?")
      UI.message(
        "build #{b.version}  (v#{ver})  " \
        "processing=#{b.processing_state}  " \
        "internal=#{detail&.internal_build_state}  " \
        "external=#{detail&.external_build_state}  " \
        "expired=#{b.expired}  uploaded=#{b.uploaded_date}"
      )
    end

    UI.message("---- beta groups ----")
    (app.get_beta_groups rescue []).each do |g|
      UI.message("group '#{g.name}'  id=#{g.id}  internal=#{g.is_internal_group}")
    end
  end

  # Standalone distribute — add an already-processed build to the internal group.
  # ENV["BUILD"] picks a specific build number; default = latest VALID build.
  desc "Add a processed build to the internal tester group (notifies testers)"
  lane :distribute do
    asc_login
    add_build_to_internal_group(build_number: ENV["BUILD"])
  end

  desc "Build, upload, and auto-distribute a new build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    # ABSOLUTE paths (relative to this Fastfile) — fastlane splits its cwd across
    # sh (runs in fastlane/), Ruby actions (validate from the fastlane root
    # ios/), and gym's xcodebuild (runs in fastlane/), so no relative
    # path satisfies all three. __dir__ is fastlane/, so ../ is ios/.
    project = File.expand_path("../Tube.xcodeproj", __dir__)
    outdir  = File.expand_path("../build", __dir__)

    # Regenerate the .xcodeproj from project.yml (never committed). sh runs from
    # fastlane/, so cd .. to reach ios/ where project.yml lives.
    sh("cd .. && xcodegen generate")

    # Give every upload a unique, increasing build number.
    build_no = ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)
    increment_build_number(build_number: build_no, xcodeproj: project)

    team    = ENV.fetch("DEVELOPMENT_TEAM")
    profile = ENV.fetch("PROFILE_NAME")          # "Tube AppStore"

    build_app(
      project: project,
      scheme: "Tube",
      export_method: "app-store",
      # Manual signing — use the cert already imported into the keychain + the
      # installed profile. No -allowProvisioningUpdates, so nothing is minted.
      # Signing (manual, profile "Tube AppStore") is set on the app target in
      # project.yml. Passing PROVISIONING_PROFILE_SPECIFIER here would apply it
      # to every Swift package target too, which Xcode rejects.
      # SwiftTerm ships a build-tool plugin a CI runner cannot approve.
      xcargs: "-skipPackagePluginValidation -skipMacroValidation DEVELOPMENT_TEAM=#{team}",
      export_options: {
        signingStyle: "manual",
        teamID: team,
        provisioningProfiles: { APP_BUNDLE_ID => profile }
      },
      output_directory: outdir,
      output_name: "Tube.ipa",
      clean: true
    )

    # Wait for Apple to finish processing (skip_waiting: false) so we can
    # immediately add the build to the internal group in this same run.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
      distribute_external: false   # internal testers — no Beta App Review
    )

    # Auto-distribute: add THIS build (by number) to the internal group + notify.
    asc_login
    add_build_to_internal_group(build_number: build_no)
  end
end
